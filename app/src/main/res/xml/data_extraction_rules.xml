    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="rpclient_secure_secrets.xml" />
        <exclude domain="database" path="request_logs.sqlite" />
        <exclude domain="database" path="request_logs.sqlite-journal" />
        <exclude domain="database" path="request_logs.sqlite-shm" />
        <exclude domain="database" path="request_logs.sqlite-wal" />
    <exclude domain="file" path="debug" />
    </device-transfer>
</data-extraction-rules>
